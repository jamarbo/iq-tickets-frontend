# IQ Outsourcing Frontend - Environment Variables

# DEMO mode (opcional). Si es true, no llama al backend y usa datos locales.
VITE_DEMO=false

# API Base URL. En desarrollo se usa proxy de Vite con base "/api".
# Ajusta tu reverse proxy en producción para servir backend bajo /api.
VITE_API_URL=/api

# App Configuration (opcional)
VITE_APP_NAME=IQ Outsourcing Tickets
VITE_APP_VERSION=1.0.0

# Development only
VITE_DEBUG=false
